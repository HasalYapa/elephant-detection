# Example environment variables for the elephant detection UI
# Copy this file to .env.local for local development

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_PORT=8080
NEXT_PUBLIC_BACKEND_PROTOCOL=http

# WebSocket URL
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8080/ws/detect
